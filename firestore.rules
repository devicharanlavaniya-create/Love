rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDateKey(dateKey) {
      return dateKey is string && dateKey.size() == 10 && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isValidTimestampsOnCreate(data) {
      return data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTimestampOnUpdate(data) {
      return data.createdAt == existing().createdAt &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidSchoolProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.schoolName is string && data.schoolName.size() >= 1 && data.schoolName.size() <= 120 &&
             data.academicYear is string && data.academicYear.size() >= 1 && data.academicYear.size() <= 40 &&
             data.principalName is string && data.principalName.size() >= 1 && data.principalName.size() <= 100 &&
             (!('motto' in data) || (data.motto is string && data.motto.size() <= 160));
    }

    function isValidSchoolClass(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 60 &&
             data.gradeLevel is string && data.gradeLevel.size() >= 1 && data.gradeLevel.size() <= 30 &&
             data.roomNumber is string && data.roomNumber.size() >= 1 && data.roomNumber.size() <= 30 &&
             data.capacity is int && data.capacity >= 1 && data.capacity <= 200 &&
             (!('homeroomTeacher' in data) || (data.homeroomTeacher is string && data.homeroomTeacher.size() <= 80)) &&
             (!('scheduleSummary' in data) || (data.scheduleSummary is string && data.scheduleSummary.size() <= 120));
    }

    function isValidStudent(data) {
      return data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.rollNumber is string && data.rollNumber.size() >= 1 && data.rollNumber.size() <= 30 &&
             isValidId(data.classId) &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 60 &&
             data.status in ['ACTIVE', 'INACTIVE', 'GRADUATED'] &&
             (!('guardianName' in data) || (data.guardianName is string && data.guardianName.size() <= 100)) &&
             (!('guardianPhone' in data) || (data.guardianPhone is string && data.guardianPhone.size() <= 30)) &&
             (!('guardianEmail' in data) || (data.guardianEmail is string && data.guardianEmail.size() <= 120)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300));
    }

    function isValidAttendanceRecord(data) {
      return isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.rollNumber is string && data.rollNumber.size() >= 1 && data.rollNumber.size() <= 30 &&
             isValidId(data.classId) &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 60 &&
             isValidDateKey(data.dateKey) &&
             data.status in ['PRESENT', 'ABSENT', 'LATE', 'EXCUSED'] &&
             (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 200));
    }

    function isValidStudentCheckIn(data) {
      return isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.rollNumber is string && data.rollNumber.size() >= 1 && data.rollNumber.size() <= 30 &&
             isValidId(data.classId) &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 60 &&
             isValidDateKey(data.dateKey) &&
             data.status in ['PRESENT', 'ABSENT', 'LATE', 'EXCUSED'] &&
             data.sessionName is string && data.sessionName.size() >= 1 && data.sessionName.size() <= 60 &&
             data.checkInTimeLabel is string && data.checkInTimeLabel.size() >= 1 && data.checkInTimeLabel.size() <= 30 &&
             (!('locationNote' in data) || (data.locationNote is string && data.locationNote.size() <= 80)) &&
             (!('remarks' in data) || (data.remarks is string && data.remarks.size() <= 200));
    }

    function isValidFacultyMember(data) {
      return data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 100 &&
             data.department is string && data.department.size() >= 1 && data.department.size() <= 60 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80 &&
             data.status in ['ACTIVE', 'ON_LEAVE'] &&
             (!('assignedClass' in data) || (data.assignedClass is string && data.assignedClass.size() <= 60)) &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 30));
    }

    function isValidCampusFacility(data) {
      return data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.category in ['LAB', 'CLASSROOM', 'LIBRARY', 'SPORTS', 'TRANSPORT', 'HALL'] &&
             data.building is string && data.building.size() >= 1 && data.building.size() <= 60 &&
             data.capacity is int && data.capacity >= 1 && data.capacity <= 2000 &&
             data.status in ['AVAILABLE', 'OCCUPIED', 'MAINTENANCE'] &&
             (!('bookedBy' in data) || (data.bookedBy is string && data.bookedBy.size() <= 80)) &&
             (!('scheduleSlot' in data) || (data.scheduleSlot is string && data.scheduleSlot.size() <= 80)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 250));
    }

    function isValidFeeInvoice(data) {
      return isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 60 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.amount is number && data.amount > 0 && data.amount <= 1000000 &&
             data.paidAmount is number && data.paidAmount >= 0 && data.paidAmount <= data.amount &&
             isValidDateKey(data.dueDateKey) &&
             data.status in ['PENDING', 'PARTIAL', 'PAID', 'OVERDUE'];
    }

    function isValidCampusNotice(data) {
      return data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
             data.category in ['GENERAL', 'EXAM', 'EVENT', 'URGENT'] &&
             data.audience is string && data.audience.size() >= 1 && data.audience.size() <= 60 &&
             data.pinned is bool;
    }

    function isValidExamGrade(data) {
      return isValidId(data.studentId) &&
             data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 100 &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 60 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 60 &&
             data.examName is string && data.examName.size() >= 1 && data.examName.size() <= 80 &&
             data.maxScore is number && data.maxScore > 0 && data.maxScore <= 1000 &&
             data.score is number && data.score >= 0 && data.score <= data.maxScore &&
             data.gradeLetter is string && data.gradeLetter.size() >= 1 && data.gradeLetter.size() <= 6 &&
             (!('term' in data) || (data.term is string && data.term.size() <= 40)) &&
             (!('assessmentType' in data) || data.assessmentType in ['EXAM', 'QUIZ', 'LAB', 'ASSIGNMENT', 'PROJECT']) &&
             (!('teacherNotes' in data) || (data.teacherNotes is string && data.teacherNotes.size() <= 200));
    }

    function isValidSchedulePeriod(data) {
      return isValidId(data.classId) &&
             data.className is string && data.className.size() >= 1 && data.className.size() <= 60 &&
             data.dayOfWeek in ['MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'] &&
             data.periodNumber is int && data.periodNumber >= 1 && data.periodNumber <= 12 &&
             data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 80 &&
             data.startTime is string && data.startTime.size() >= 1 && data.startTime.size() <= 20 &&
             data.endTime is string && data.endTime.size() >= 1 && data.endTime.size() <= 20 &&
             data.facultyName is string && data.facultyName.size() >= 1 && data.facultyName.size() <= 100 &&
             (!('facultyId' in data) || (data.facultyId is string && data.facultyId.size() <= 128)) &&
             (!('roomNumber' in data) || (data.roomNumber is string && data.roomNumber.size() <= 40)) &&
             (!('topicNotes' in data) || (data.topicNotes is string && data.topicNotes.size() <= 200));
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidSchoolProfile(incoming(), userId) &&
                       isValidTimestampsOnCreate(incoming()) &&
                       incoming().keys().hasAll(['userId', 'schoolName', 'academicYear', 'principalName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'schoolName', 'academicYear', 'principalName', 'motto', 'createdAt', 'updatedAt']);
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidSchoolProfile(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       isValidTimestampOnUpdate(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['schoolName', 'academicYear', 'principalName', 'motto', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /classes/{classId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(classId);
        allow create: if isOwner(userId) &&
                         isValidId(classId) &&
                         isValidSchoolClass(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['name', 'gradeLevel', 'roomNumber', 'capacity', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['name', 'gradeLevel', 'roomNumber', 'homeroomTeacher', 'scheduleSummary', 'capacity', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) &&
                         isValidId(classId) &&
                         isValidSchoolClass(incoming()) &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'gradeLevel', 'roomNumber', 'homeroomTeacher', 'scheduleSummary', 'capacity', 'updatedAt']);
      }

      match /students/{studentId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(studentId);
        allow create: if isOwner(userId) &&
                         isValidId(studentId) &&
                         isValidStudent(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['fullName', 'rollNumber', 'classId', 'className', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['fullName', 'rollNumber', 'classId', 'className', 'guardianName', 'guardianPhone', 'guardianEmail', 'status', 'notes', 'createdAt', 'updatedAt']) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/classes/$(incoming().classId));
        allow update: if isOwner(userId) &&
                         isValidId(studentId) &&
                         isValidStudent(incoming()) &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'rollNumber', 'classId', 'className', 'guardianName', 'guardianPhone', 'guardianEmail', 'status', 'notes', 'updatedAt']);
      }

      match /attendance/{recordId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(recordId);
        allow create: if isOwner(userId) &&
                         isValidId(recordId) &&
                         isValidAttendanceRecord(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['studentId', 'studentName', 'rollNumber', 'classId', 'className', 'dateKey', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['studentId', 'studentName', 'rollNumber', 'classId', 'className', 'dateKey', 'status', 'remarks', 'createdAt', 'updatedAt']) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/students/$(incoming().studentId));
        allow update: if isOwner(userId) &&
                         isValidId(recordId) &&
                         isValidAttendanceRecord(incoming()) &&
                         incoming().studentId == existing().studentId &&
                         incoming().dateKey == existing().dateKey &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'rollNumber', 'classId', 'className', 'status', 'remarks', 'updatedAt']);
      }

      match /student_checkins/{checkInId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(checkInId);
        allow create: if isOwner(userId) &&
                         isValidId(checkInId) &&
                         isValidStudentCheckIn(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['studentId', 'studentName', 'rollNumber', 'classId', 'className', 'dateKey', 'status', 'sessionName', 'checkInTimeLabel', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['studentId', 'studentName', 'rollNumber', 'classId', 'className', 'dateKey', 'status', 'sessionName', 'checkInTimeLabel', 'locationNote', 'remarks', 'createdAt', 'updatedAt']) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/students/$(incoming().studentId));
        allow update: if isOwner(userId) &&
                         isValidId(checkInId) &&
                         isValidStudentCheckIn(incoming()) &&
                         incoming().studentId == existing().studentId &&
                         incoming().dateKey == existing().dateKey &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'rollNumber', 'classId', 'className', 'status', 'sessionName', 'checkInTimeLabel', 'locationNote', 'remarks', 'updatedAt']);
      }

      match /faculty/{facultyId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(facultyId);
        allow create: if isOwner(userId) &&
                         isValidId(facultyId) &&
                         isValidFacultyMember(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['fullName', 'department', 'subject', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['fullName', 'department', 'subject', 'assignedClass', 'email', 'phone', 'status', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) &&
                         isValidId(facultyId) &&
                         isValidFacultyMember(incoming()) &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'department', 'subject', 'assignedClass', 'email', 'phone', 'status', 'updatedAt']);
      }

      match /facilities/{facilityId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(facilityId);
        allow create: if isOwner(userId) &&
                         isValidId(facilityId) &&
                         isValidCampusFacility(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['name', 'category', 'building', 'capacity', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['name', 'category', 'building', 'capacity', 'status', 'bookedBy', 'scheduleSlot', 'notes', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) &&
                         isValidId(facilityId) &&
                         isValidCampusFacility(incoming()) &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'building', 'capacity', 'status', 'bookedBy', 'scheduleSlot', 'notes', 'updatedAt']);
      }

      match /fees/{feeId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(feeId);
        allow create: if isOwner(userId) &&
                         isValidId(feeId) &&
                         isValidFeeInvoice(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['studentId', 'studentName', 'className', 'title', 'amount', 'paidAmount', 'dueDateKey', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['studentId', 'studentName', 'className', 'title', 'amount', 'paidAmount', 'dueDateKey', 'status', 'createdAt', 'updatedAt']) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/students/$(incoming().studentId));
        allow update: if isOwner(userId) &&
                         isValidId(feeId) &&
                         isValidFeeInvoice(incoming()) &&
                         incoming().studentId == existing().studentId &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'className', 'title', 'amount', 'paidAmount', 'dueDateKey', 'status', 'updatedAt']);
      }

      match /notices/{noticeId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(noticeId);
        allow create: if isOwner(userId) &&
                         isValidId(noticeId) &&
                         isValidCampusNotice(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['title', 'body', 'category', 'audience', 'pinned', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['title', 'body', 'category', 'audience', 'pinned', 'createdAt', 'updatedAt']);
        allow update: if isOwner(userId) &&
                         isValidId(noticeId) &&
                         isValidCampusNotice(incoming()) &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'category', 'audience', 'pinned', 'updatedAt']);
      }

      match /grades/{gradeId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(gradeId);
        allow create: if isOwner(userId) &&
                         isValidId(gradeId) &&
                         isValidExamGrade(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['studentId', 'studentName', 'className', 'subject', 'examName', 'score', 'maxScore', 'gradeLetter', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['studentId', 'studentName', 'className', 'subject', 'examName', 'score', 'maxScore', 'gradeLetter', 'term', 'assessmentType', 'teacherNotes', 'createdAt', 'updatedAt']) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/students/$(incoming().studentId));
        allow update: if isOwner(userId) &&
                         isValidId(gradeId) &&
                         isValidExamGrade(incoming()) &&
                         incoming().studentId == existing().studentId &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['studentName', 'className', 'subject', 'examName', 'score', 'maxScore', 'gradeLetter', 'term', 'assessmentType', 'teacherNotes', 'updatedAt']);
      }

      match /schedules/{scheduleId} {
        allow list: if isOwner(userId);
        allow get, delete: if isOwner(userId) && isValidId(scheduleId);
        allow create: if isOwner(userId) &&
                         isValidId(scheduleId) &&
                         isValidSchedulePeriod(incoming()) &&
                         isValidTimestampsOnCreate(incoming()) &&
                         incoming().keys().hasAll(['classId', 'className', 'dayOfWeek', 'periodNumber', 'subject', 'startTime', 'endTime', 'facultyName', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['classId', 'className', 'dayOfWeek', 'periodNumber', 'subject', 'startTime', 'endTime', 'facultyId', 'facultyName', 'roomNumber', 'topicNotes', 'createdAt', 'updatedAt']) &&
                         existsAfter(/databases/$(database)/documents/users/$(userId)/classes/$(incoming().classId));
        allow update: if isOwner(userId) &&
                         isValidId(scheduleId) &&
                         isValidSchedulePeriod(incoming()) &&
                         incoming().classId == existing().classId &&
                         isValidTimestampOnUpdate(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['className', 'dayOfWeek', 'periodNumber', 'subject', 'startTime', 'endTime', 'facultyId', 'facultyName', 'roomNumber', 'topicNotes', 'updatedAt']);
      }
    }
  }
}
